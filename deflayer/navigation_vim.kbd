;; Vim-Navigation layer:
;;  - right: Vim-like arrows on HJKL, home/end page up/down, mouse scroll
;;  - left: one-hand shortcuts (Cmd/Ctrl-WASZXCVY), Tab/Shift-Tab, prev/next
;;  - top: function keys

;; The `lrld` action stands for "live reload". This will re-parse everything
;; except for linux-dev, i.e. you cannot live reload and switch keyboard devices.

(deflayer navigation
  lrld
  f1   f2   f3   f4   f5      @v+   f6   f7    f8    f9   f10  f11  f12
  XX   @cls @bck  @fwd  XX    @v-   home @wksl @wksr end  @lck @b-  @b+
  @all @sav S-tab tab   XX    @v0   lft  down  up    rght XX   _
  @ndo @cut @cpy @pst @rdo    _     @sel @mvl  @mvr  @ser XX
            @del              _                @fun
)

;; Mouse wheel emulation
(defalias
  del (tap-hold-press $QUICK_TAP $HOLDING_TERM del lsft)
  bck (fork bck (multi lsft @`) (lmet lalt))
  fwd (fork fwd @` (lmet lalt))
  wksl (fork pgdn pgup (lmet))
  wksr (fork pgup pgdn (lmet))
  sel S-C-lft
  ser S-C-rght
  mvl C-lft
  mvr C-rght
  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120)
)

;; vim: set ft=lisp:
